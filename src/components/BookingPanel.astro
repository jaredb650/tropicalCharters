---
// Design preview of the booking flow. At launch, availability and payment come from
// cal.com (one event type per boat per trip, each boat's Google Calendar for conflicts,
// Stripe for payment). See ARCHITECTURE.md.
import { boatBySlug, boatPrice } from '../data/boats';
import { money, type Trip } from '../data/trips';
import { t, type Lang } from '../i18n';

interface Props {
  lang: Lang;
  trip: Trip;
}
const { lang, trip } = Astro.props;
const ui = t(lang).booking;
const options = trip.boats.map((slug) => {
  const b = boatBySlug(slug);
  return { slug, name: b.name, kind: b.kind[lang], guests: b.guests, price: boatPrice(trip.priceFrom, b) };
});
options.sort((a, b) => a.price - b.price);
const config = {
  lang,
  trip: trip.slug,
  boats: options,
  labels: { unavailable: ui.unavailable, pickDate: ui.pickDate, demo: ui.demo },
};
---

<aside class="book" data-booking aria-labelledby="book-title">
  <h2 id="book-title" class="book__title">{ui.title}</h2>

  <fieldset class="book__group">
    <legend>{ui.boat}</legend>
    <div class="book__boats">
      {
        options.map((o, i) => (
          <label class="book__boat">
            <input type="radio" name="boat" value={o.slug} checked={i === 0} />
            <span class="book__boat-name">{o.name}</span>
            <span class="book__boat-kind">
              {o.kind}, {t(lang).trips.guests(o.guests).toLowerCase()}
            </span>
            <span class="book__boat-price numeric">{money(o.price, lang)}</span>
          </label>
        ))
      }
    </div>
  </fieldset>

  <fieldset class="book__group">
    <legend>{ui.date}</legend>
    <div class="cal">
      <div class="cal__head">
        <button type="button" class="cal__nav" data-cal-prev aria-label={ui.prevMonth}>
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M15 5l-7 7 7 7" /></svg>
        </button>
        <p class="cal__month" data-cal-month aria-live="polite"></p>
        <button type="button" class="cal__nav" data-cal-next aria-label={ui.nextMonth}>
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 5l7 7-7 7" /></svg>
        </button>
      </div>
      <div class="cal__dow numeric" data-cal-dow aria-hidden="true"></div>
      <div class="cal__grid numeric" data-cal-grid role="grid"></div>
    </div>
  </fieldset>

  <div class="book__group book__guests">
    <span id="guests-label">{ui.guests}</span>
    <div class="stepper" role="group" aria-labelledby="guests-label">
      <button type="button" data-step="-1" aria-label={ui.less}>−</button>
      <output class="numeric" data-guests aria-live="polite">2</output>
      <button type="button" data-step="1" aria-label={ui.more}>+</button>
    </div>
  </div>

  <div class="book__total">
    <span>{ui.total}</span>
    <strong class="numeric" data-total>{money(options[0].price, lang)}</strong>
  </div>

  <button type="button" class="btn book__cta" data-cta aria-disabled="true">{ui.cta}</button>
  <p class="book__note" data-note aria-live="polite">{ui.pickDate}</p>

  <script type="application/json" data-config set:html={JSON.stringify(config)} />
</aside>

<style>
  .book {
    background: var(--salt);
    border: 1px solid var(--line);
    border-radius: 4px;
    padding: clamp(1.25rem, 2vw, 2rem);
    box-shadow: 0 30px 60px -40px rgb(11 44 61 / 0.35);
  }
  .book__title {
    font-size: 1.9rem;
    margin-bottom: 1.4rem;
  }
  .book__group {
    border: 0;
    padding: 0;
    margin: 0 0 1.5rem;
  }
  .book__group legend,
  .book__guests > span {
    font-size: var(--t-small);
    color: var(--ink-soft);
    margin-bottom: 0.6rem;
    padding: 0;
  }
  .book__boats {
    display: grid;
    gap: 0.5rem;
  }
  .book__boat {
    position: relative;
    display: grid;
    grid-template-columns: 1fr auto;
    column-gap: 1rem;
    padding: 0.8rem 1rem;
    border: 1px solid var(--line);
    border-radius: 3px;
    cursor: pointer;
    transition:
      border-color 0.3s,
      background 0.3s;
  }
  .book__boat input {
    position: absolute;
    opacity: 0;
  }
  .book__boat:has(input:checked) {
    border-color: var(--atlantic);
    background: color-mix(in oklab, var(--lagoon) 45%, var(--salt));
  }
  .book__boat:has(input:focus-visible) {
    outline: 2px solid var(--brass);
    outline-offset: 2px;
  }
  .book__boat-name {
    font-family: var(--serif);
    font-size: 1.2rem;
  }
  .book__boat-kind {
    grid-row: 2;
    font-size: 0.82rem;
    color: var(--ink-soft);
  }
  .book__boat-price {
    grid-row: 1 / 3;
    grid-column: 2;
    align-self: center;
    font-family: var(--serif);
    font-size: 1.05rem;
  }

  .cal__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 0.5rem;
  }
  .cal__month {
    font-family: var(--serif);
    font-size: 1.1rem;
    text-transform: capitalize;
  }
  .cal__nav {
    width: 36px;
    height: 36px;
    border: 1px solid var(--line);
    border-radius: 50%;
    background: none;
    cursor: pointer;
    display: grid;
    place-items: center;
  }
  .cal__nav:disabled {
    opacity: 0.3;
    cursor: default;
  }
  .cal__nav svg {
    width: 16px;
    height: 16px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.5;
  }
  .cal__dow,
  .cal__grid {
    display: grid;
    grid-template-columns: repeat(7, 1fr);
    text-align: center;
  }
  .cal__dow {
    font-size: 0.75rem;
    color: var(--ink-soft);
    padding-block: 0.4rem;
  }
  .cal__grid :global(button) {
    aspect-ratio: 1;
    border: 0;
    background: none;
    border-radius: 50%;
    font-size: 0.9rem;
    cursor: pointer;
    position: relative;
    transition:
      background 0.25s,
      color 0.25s;
  }
  .cal__grid :global(button:hover:not(:disabled)) {
    background: var(--lagoon);
  }
  .cal__grid :global(button:disabled) {
    color: color-mix(in oklab, var(--atlantic) 28%, transparent);
    cursor: default;
  }
  .cal__grid :global(button.is-booked) {
    text-decoration: line-through;
  }
  .cal__grid :global(button[aria-pressed='true']) {
    background: var(--atlantic);
    color: var(--salt);
  }

  .book__guests {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }
  .book__guests > span {
    margin: 0;
  }
  .stepper {
    display: flex;
    align-items: center;
    gap: 0.9rem;
  }
  .stepper button {
    width: 36px;
    height: 36px;
    border-radius: 50%;
    border: 1px solid var(--line);
    background: none;
    cursor: pointer;
    font-size: 1.1rem;
    line-height: 1;
  }
  .stepper button:disabled {
    opacity: 0.3;
    cursor: default;
  }
  .stepper output {
    min-width: 1.6em;
    text-align: center;
    font-family: var(--serif);
    font-size: 1.2rem;
  }
  .book__total {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    padding-top: 1.1rem;
    margin-bottom: 1.1rem;
    border-top: 1px solid var(--line);
  }
  .book__total strong {
    font-family: var(--serif);
    font-weight: 400;
    font-size: 1.8rem;
  }
  .book__cta {
    width: 100%;
    justify-content: center;
  }
  .book__cta[aria-disabled='true'] {
    opacity: 0.45;
    cursor: not-allowed;
  }
  .book__cta[aria-disabled='true']::before {
    display: none;
  }
  .book__note {
    margin-top: 0.8rem;
    font-size: 0.82rem;
    color: var(--ink-soft);
    text-align: center;
    min-height: 2.6em;
  }
</style>

<script>
  import { gsap } from '../scripts/motion';

  type Opt = { slug: string; name: string; guests: number; price: number };
  const root = document.querySelector<HTMLElement>('[data-booking]');
  if (root) {
    const cfg = JSON.parse(root.querySelector('[data-config]')!.textContent!) as {
      lang: 'en' | 'es';
      trip: string;
      boats: Opt[];
      labels: Record<string, string>;
    };
    const locale = cfg.lang === 'en' ? 'en-US' : 'es-PR';
    const money = new Intl.NumberFormat(locale, { style: 'currency', currency: 'USD', maximumFractionDigits: 0 });
    const monthFmt = new Intl.DateTimeFormat(locale, { month: 'long', year: 'numeric' });
    const dayFmt = new Intl.DateTimeFormat(locale, { weekday: 'long', month: 'long', day: 'numeric' });

    const grid = root.querySelector<HTMLElement>('[data-cal-grid]')!;
    const monthEl = root.querySelector<HTMLElement>('[data-cal-month]')!;
    const prev = root.querySelector<HTMLButtonElement>('[data-cal-prev]')!;
    const guestsEl = root.querySelector<HTMLOutputElement>('[data-guests]')!;
    const totalEl = root.querySelector<HTMLElement>('[data-total]')!;
    const cta = root.querySelector<HTMLButtonElement>('[data-cta]')!;
    const note = root.querySelector<HTMLElement>('[data-note]')!;

    // Week starts on Sunday, as on most calendars in Puerto Rico.
    const dow = root.querySelector<HTMLElement>('[data-cal-dow]')!;
    const narrow = new Intl.DateTimeFormat(locale, { weekday: 'narrow' });
    for (let i = 0; i < 7; i++) {
      const s = document.createElement('span');
      s.textContent = narrow.format(new Date(2024, 8, 1 + i));
      dow.appendChild(s);
    }

    const today = new Date();
    today.setHours(0, 0, 0, 0);
    let view = new Date(today.getFullYear(), today.getMonth(), 1);
    let boat = cfg.boats[0];
    let date: Date | null = null;
    let guests = Math.min(2, boat.guests);

    // Stand-in availability: a stable pseudo-random set of booked days per boat.
    const booked = (d: Date) => {
      const key = `${boat.slug}-${d.toISOString().slice(0, 10)}`;
      let h = 0;
      for (const c of key) h = (h * 31 + c.charCodeAt(0)) >>> 0;
      return h % 5 === 0;
    };

    const renderCal = () => {
      monthEl.textContent = monthFmt.format(view);
      prev.disabled = view <= new Date(today.getFullYear(), today.getMonth(), 1);
      grid.replaceChildren();
      const first = new Date(view);
      for (let i = 0; i < first.getDay(); i++) grid.appendChild(document.createElement('span'));
      const days = new Date(view.getFullYear(), view.getMonth() + 1, 0).getDate();
      for (let d = 1; d <= days; d++) {
        const day = new Date(view.getFullYear(), view.getMonth(), d);
        const btn = document.createElement('button');
        btn.type = 'button';
        btn.textContent = String(d);
        const isBooked = day > today && booked(day);
        btn.disabled = day <= today || isBooked;
        btn.classList.toggle('is-booked', isBooked);
        btn.setAttribute('aria-label', `${dayFmt.format(day)}${isBooked ? `, ${cfg.labels.unavailable}` : ''}`);
        btn.setAttribute('aria-pressed', String(!!date && day.getTime() === date.getTime()));
        btn.addEventListener('click', () => {
          date = day;
          grid.querySelectorAll('button').forEach((b) => b.setAttribute('aria-pressed', 'false'));
          btn.setAttribute('aria-pressed', 'true');
          gsap.fromTo(btn, { scale: 0.7 }, { scale: 1, duration: 0.5, ease: 'back.out(3)' });
          update();
        });
        grid.appendChild(btn);
      }
    };

    const update = () => {
      guests = Math.min(guests, boat.guests);
      guestsEl.value = String(guests);
      root.querySelector<HTMLButtonElement>('[data-step="-1"]')!.disabled = guests <= 1;
      root.querySelector<HTMLButtonElement>('[data-step="1"]')!.disabled = guests >= boat.guests;
      const next = money.format(boat.price);
      if (totalEl.textContent !== next) {
        totalEl.textContent = next;
        gsap.fromTo(totalEl, { y: 10, opacity: 0 }, { y: 0, opacity: 1, duration: 0.5, ease: 'expo.out' });
      }
      cta.setAttribute('aria-disabled', String(!date));
      note.textContent = date ? `${boat.name}, ${dayFmt.format(date)}` : cfg.labels.pickDate;
    };

    root.querySelectorAll<HTMLInputElement>('input[name="boat"]').forEach((input) =>
      input.addEventListener('change', () => {
        boat = cfg.boats.find((b) => b.slug === input.value)!;
        if (date && booked(date)) date = null;
        renderCal();
        update();
      }),
    );
    root.querySelectorAll<HTMLButtonElement>('[data-step]').forEach((b) =>
      b.addEventListener('click', () => {
        guests = Math.max(1, Math.min(boat.guests, guests + Number(b.dataset.step)));
        update();
      }),
    );
    prev.addEventListener('click', () => {
      view = new Date(view.getFullYear(), view.getMonth() - 1, 1);
      renderCal();
    });
    root.querySelector('[data-cal-next]')!.addEventListener('click', () => {
      view = new Date(view.getFullYear(), view.getMonth() + 1, 1);
      renderCal();
    });
    cta.addEventListener('click', () => {
      if (cta.getAttribute('aria-disabled') === 'true') {
        gsap.fromTo(grid, { x: -6 }, { x: 0, duration: 0.5, ease: 'elastic.out(1, 0.3)' });
        return;
      }
      note.textContent = cfg.labels.demo;
    });

    renderCal();
    update();
  }
</script>
