---
import { guides } from '../data/content';
import { t, type Lang } from '../i18n';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const ui = t(lang).journal;
const read = (m: number) => (lang === 'en' ? `${m} min read` : `${m} min de lectura`);
---

<section class="journal" id="journal" data-journal>
  <div class="wrap">
    <h2>{ui.title}</h2>
    <div class="journal__grid">
      {
        guides.map((g, i) => (
          <article class:list={['guide', `guide--${i}`]}>
            <div class="guide__media">
              <img src={g.image} alt="" loading="lazy" data-guide-img />
            </div>
            <h3>{g.title[lang]}</h3>
            <p class="numeric">{read(g.minutes)}</p>
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  .journal {
    padding-block: clamp(6rem, 16vh, 10rem);
  }
  .journal h2 {
    max-width: 11em;
    margin-bottom: clamp(3rem, 7vh, 5rem);
  }
  .journal__grid {
    display: grid;
    grid-template-columns: 1.3fr 1fr 1fr;
    gap: clamp(1.5rem, 3vw, 3rem);
    align-items: start;
  }
  .guide--1 {
    margin-top: 6rem;
  }
  .guide--2 {
    margin-top: 2.5rem;
  }
  .guide__media {
    aspect-ratio: 4 / 5;
    overflow: hidden;
    border-radius: 2px;
    margin-bottom: 1.2rem;
  }
  .guide--0 .guide__media {
    aspect-ratio: 4 / 4.4;
  }
  .guide__media img {
    width: 100%;
    height: 118%;
    object-fit: cover;
  }
  .guide h3 {
    font-size: clamp(1.3rem, 1rem + 0.8vw, 1.75rem);
    line-height: 1.15;
    margin-bottom: 0.5rem;
  }
  .guide p {
    font-size: var(--t-small);
    color: var(--ink-soft);
  }
  @media (max-width: 800px) {
    .journal__grid {
      grid-template-columns: 1fr;
      gap: 3rem;
    }
    .guide--1,
    .guide--2 {
      margin-top: 0;
    }
  }
</style>

<script>
  import { gsap, reducedMotion } from '../scripts/motion';

  if (!reducedMotion) {
    // Photos drift slower than the page, so the column offsets feel like depth.
    document.querySelectorAll('[data-guide-img]').forEach((img) => {
      gsap.fromTo(
        img,
        { yPercent: -12 },
        { yPercent: 0, ease: 'none', scrollTrigger: { trigger: img.parentElement, start: 'top bottom', end: 'bottom top', scrub: true } },
      );
    });
  }
</script>
