---
import { t, type Lang } from '../i18n';
import { withBase } from '../lib/paths';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;

// Place names get a small photo set inline after them.
const pills: Record<string, string> = {
  cays: '/images/sandbar.webp',
  cayos: '/images/sandbar.webp',
  Culebra: '/images/turtle.webp',
  Vieques: '/images/cove.webp',
};
const words = t(lang).statement.split(' ');
const bare = (w: string) => w.replace(/[^\p{L}]/gu, '');
---

<section class="statement" data-statement>
  <div class="wrap">
    <p class="statement__text">
      {
        words.map((w) => (
          <>
            <span class="statement__word">{w}</span>{' '}
            {pills[bare(w)] && (
              <>
                <span class="statement__pill" aria-hidden="true">
                  <img src={withBase(pills[bare(w)])} alt="" loading="lazy" />
                </span>{' '}
              </>
            )}
          </>
        ))
      }
    </p>
  </div>
</section>

<style>
  .statement {
    padding-block: clamp(6rem, 18vh, 12rem);
  }
  .statement__text {
    font-family: var(--serif);
    font-size: clamp(1.8rem, 1rem + 3vw, 4rem);
    line-height: 1.16;
    letter-spacing: -0.012em;
    max-width: 24em;
    text-wrap: pretty;
  }
  .statement__pill {
    display: inline-block;
    width: 1.9em;
    height: 0.95em;
    border-radius: 999px;
    overflow: hidden;
    vertical-align: -0.06em;
    background: var(--lagoon);
  }
  .statement__pill img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
</style>

<script>
  import { gsap, reducedMotion } from '../scripts/motion';

  const section = document.querySelector<HTMLElement>('[data-statement]')!;
  if (!reducedMotion) {
    const words = [...section.querySelectorAll('.statement__word')];
    const tl = gsap
      .timeline({ scrollTrigger: { trigger: section, start: 'top 75%', end: 'bottom 60%', scrub: 0.6 } })
      .fromTo(words, { opacity: 0.14 }, { opacity: 1, stagger: 0.05, ease: 'none' }, 0);
    // Each photo opens as the place name before it lights up.
    section.querySelectorAll('.statement__pill').forEach((pill) => {
      const at = words.indexOf(pill.previousElementSibling!) * 0.05;
      tl.fromTo(pill, { width: 0, opacity: 0 }, { width: '1.9em', opacity: 1, duration: 0.4, ease: 'power2.out' }, at);
    });
  }
</script>
