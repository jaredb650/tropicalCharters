---
import { money, optionFrom, trips } from '../data/trips';
import { href, t, type Lang } from '../i18n';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const ui = t(lang).trips;

const destinations = trips.filter((x) => x.kind === 'destination');
const experiences = trips.filter((x) => x.kind === 'experience');
// Three-length packages open on the middle option; it's the one most groups pick.
const defaultIndex = (n: number) => (n === 3 ? 1 : 0);
const cards = [
  ...destinations.map((trip, i) => ({ trip, wide: i >= 3 })),
  ...experiences.map((trip) => ({ trip, wide: true })),
];
---

<section class="pkgs" id="trips" data-pkgs>
  <div class="wrap">
    <header class="pkgs__head">
      <h2>{t(lang).trips.title}</h2>
      <p class="lead">{ui.intro}</p>
    </header>

    <div class="pkgs__grid">
      {
        cards.map(({ trip, wide }, n) => {
          const url = href(lang, `/trips/${trip.slug}/`);
          const d = defaultIndex(trip.options.length);
          return (
            <>
              {n === destinations.length && <h3 class="pkgs__sub">{ui.more}</h3>}
              <article class:list={['pkg', { 'pkg--wide': wide }]} data-pkg data-url={url}>
                <a class="pkg__media" href={`${url}?h=${trip.options[d].hours}`} tabindex="-1" aria-hidden="true" data-pkg-link>
                  <img src={trip.image} alt="" loading="lazy" />
                </a>
                <div class="pkg__body">
                  <h3 class="pkg__name">
                    <a href={`${url}?h=${trip.options[d].hours}`} data-pkg-link>
                      {trip.name[lang]}
                    </a>
                  </h3>
                  {trip.nm && trip.travel && <p class="pkg__away numeric">{ui.away(trip.nm, trip.travel[lang])}</p>}
                  <p class="pkg__summary">{trip.summary[lang]}</p>

                  {trip.options.length > 1 ? (
                    <label class="select pkg__select">
                      <span>{ui.length}</span>
                      <select data-length>
                        {trip.options.map((o, i) => (
                          <option value={o.hours} selected={i === d} data-price={ui.from(money(optionFrom(trip, o), lang))}>
                            {ui.hours(o.hours)}
                          </option>
                        ))}
                      </select>
                    </label>
                  ) : (
                    <p class="pkg__single numeric">
                      {trip.kind === 'destination' ? `${ui.fullDay}, ${ui.hours(trip.options[0].hours).toLowerCase()}` : ui.hours(trip.options[0].hours)}
                    </p>
                  )}

                  <div class="pkg__fits">
                    {trip.options.map((o, i) => (
                      <ul data-fits={o.hours} hidden={i !== d}>
                        {o.fits[lang].map((f) => <li>{f}</li>)}
                      </ul>
                    ))}
                  </div>

                  {trip.notice && (
                    <div class="warning pkg__warning" role="note">
                      <svg viewBox="0 0 24 24" aria-hidden="true">
                        <rect x="5" y="3" width="14" height="18" rx="2" />
                        <circle cx="12" cy="10" r="3" />
                        <path d="M9 16h6" />
                      </svg>
                      <strong>{trip.notice.title[lang]}</strong>
                      <p>{trip.notice.body[lang]}</p>
                    </div>
                  )}

                  <div class="pkg__foot">
                    <p class="pkg__price numeric">
                      <span data-price>{ui.from(money(optionFrom(trip, trip.options[d]), lang))}</span>
                      <small>{ui.perBoat}</small>
                    </p>
                    <a class="btn pkg__book" href={`${url}?h=${trip.options[d].hours}`} data-pkg-link>
                      {ui.book}
                    </a>
                  </div>
                </div>
              </article>
            </>
          );
        })
      }
    </div>
  </div>
</section>

<style>
  .pkgs {
    padding-block: clamp(6rem, 16vh, 11rem);
  }
  .pkgs__head {
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: end;
    gap: 2rem;
    margin-bottom: clamp(2.5rem, 6vh, 4.5rem);
  }
  .pkgs__grid {
    display: grid;
    grid-template-columns: repeat(6, minmax(0, 1fr));
    gap: clamp(2.5rem, 5vh, 4rem) clamp(1.25rem, 2.2vw, 2.25rem);
  }
  .pkgs__sub {
    grid-column: 1 / -1;
    font-size: clamp(1.6rem, 1.2rem + 1.2vw, 2.4rem);
    font-style: italic;
    padding-top: clamp(1rem, 3vh, 2rem);
    border-top: 1px solid var(--line);
  }
  /* Each package is its own bordered card so the grid reads as separate choices */
  .pkg {
    grid-column: span 2;
    display: flex;
    flex-direction: column;
    padding: 0.75rem 0.75rem 1.25rem;
    border: 1.5px solid color-mix(in oklab, var(--atlantic) 22%, transparent);
    border-radius: 10px;
    background: #fff;
    box-shadow: 0 1px 0 rgb(11 44 61 / 0.04);
    transition:
      border-color 0.4s var(--ease),
      box-shadow 0.5s var(--ease),
      translate 0.5s var(--ease);
  }
  .pkg:hover {
    border-color: var(--atlantic);
    box-shadow: 0 24px 40px -28px rgb(11 44 61 / 0.45);
    translate: 0 -4px;
  }
  .pkg__body {
    padding-inline: 0.5rem;
  }
  .pkg--wide {
    grid-column: span 3;
  }
  .pkg__media {
    display: block;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    border-radius: 6px;
    margin-bottom: 1.25rem;
    background: var(--lagoon);
  }
  .pkg--wide .pkg__media {
    aspect-ratio: 16 / 9;
  }
  .pkg__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 1.4s var(--ease);
  }
  .pkg:hover .pkg__media img {
    transform: scale(1.04);
  }
  .pkg__body {
    display: flex;
    flex-direction: column;
    flex: 1;
  }
  .pkg__name {
    font-size: clamp(1.7rem, 1.3rem + 1vw, 2.4rem);
    margin-bottom: 0.35rem;
  }
  .pkg__name a {
    text-decoration: none;
  }
  .pkg__away {
    font-size: var(--t-small);
    color: var(--ink-soft);
    margin-bottom: 0.9rem;
  }
  .pkg__summary {
    color: var(--ink-soft);
    margin-bottom: 1.25rem;
    max-width: 46ch;
  }
  /* Reserve three lines so the dropdowns line up across a row */
  @media (min-width: 1001px) {
    .pkg:not(.pkg--wide) .pkg__summary {
      min-height: calc(1.6em * 3);
    }
  }
  .pkg__select {
    margin-bottom: 1.1rem;
    max-width: 16rem;
  }
  .pkg__single {
    font-size: 0.92rem;
    margin-bottom: 1rem;
    padding: 0.45rem 0;
  }
  .pkg__fits ul {
    list-style: none;
    margin: 0 0 1.25rem;
    padding: 0;
    font-size: 0.95rem;
  }
  .pkg__fits li {
    position: relative;
    padding: 0.2rem 0 0.2rem 1.2rem;
  }
  .pkg__fits li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.85em;
    width: 0.6rem;
    height: 1px;
    background: var(--brass);
  }
  .pkg__warning {
    margin-bottom: 1.25rem;
  }
  .pkg__foot {
    margin-top: auto;
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 1rem;
    padding-top: 1rem;
    border-top: 1px solid var(--line);
  }
  .pkg__price {
    font-family: var(--serif);
    font-size: 1.25rem;
    line-height: 1.2;
  }
  .pkg__price small {
    display: block;
    font-family: var(--sans);
    font-size: 0.8rem;
    color: var(--ink-soft);
  }
  .pkg__price span {
    display: inline-block;
  }
  .pkg__book {
    padding: 0.75em 1.25em;
    white-space: nowrap;
  }

  @media (max-width: 1000px) {
    .pkgs__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .pkg,
    .pkg--wide {
      grid-column: span 1;
    }
    .pkg--wide .pkg__media {
      aspect-ratio: 4 / 3;
    }
  }
  @media (max-width: 640px) {
    .pkgs__head,
    .pkgs__grid {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  import { gsap, ScrollTrigger, reducedMotion } from '../scripts/motion';

  const section = document.querySelector<HTMLElement>('[data-pkgs]')!;
  const cards = section.querySelectorAll<HTMLElement>('[data-pkg]');

  cards.forEach((card) => {
    const price = card.querySelector<HTMLElement>('[data-price]')!;
    card.querySelector<HTMLSelectElement>('[data-length]')?.addEventListener('change', (e) => {
      const select = e.currentTarget as HTMLSelectElement;
      const h = select.value;
      // Every link on the card carries the chosen length to the trip page.
      card.querySelectorAll<HTMLAnchorElement>('[data-pkg-link]').forEach((a) => (a.href = `${card.dataset.url}?h=${h}`));

      const next = card.querySelector<HTMLElement>(`[data-fits="${h}"]`)!;
      const prev = card.querySelector<HTMLElement>('[data-fits]:not([hidden])');
      if (prev && prev !== next) prev.hidden = true;
      next.hidden = false;
      price.textContent = select.selectedOptions[0].dataset.price!;
      if (!reducedMotion) {
        gsap.fromTo(next.children, { opacity: 0, x: -8 }, { opacity: 1, x: 0, duration: 0.5, stagger: 0.05, ease: 'expo.out' });
        gsap.fromTo(price, { y: 12, opacity: 0 }, { y: 0, opacity: 1, duration: 0.5, ease: 'expo.out' });
      }
    });
  });

  if (!reducedMotion) {
    gsap.set(cards, { opacity: 0, y: 50 });
    ScrollTrigger.batch(cards, {
      start: 'top 90%',
      once: true,
      onEnter: (batch) => gsap.to(batch, { opacity: 1, y: 0, duration: 1.1, stagger: 0.1, ease: 'expo.out' }),
    });
  }
</script>
