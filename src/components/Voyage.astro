---
import { stops } from '../data/voyage';
import { href, t, type Lang } from '../i18n';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const ui = t(lang).voyage;

// ---- Chart geometry ----
// Projection: x = (lon + 65.80) * 1000, y = (18.45 - lat) * 1000, so 1 nautical mile ≈ 16.7 units.
type Pt = [number, number];

/** Smooth a list of points into a cubic Bézier path (Catmull-Rom). */
function smooth(pts: Pt[], closed = false) {
  const p = closed ? [pts[pts.length - 1], ...pts, pts[0], pts[1]] : [pts[0], ...pts, pts[pts.length - 1]];
  let d = `M${p[1][0]},${p[1][1]}`;
  for (let i = 1; i < p.length - 2; i++) {
    const [p0, p1, p2, p3] = [p[i - 1], p[i], p[i + 1], p[i + 2]];
    const c1 = [p1[0] + (p2[0] - p0[0]) / 6, p1[1] + (p2[1] - p0[1]) / 6];
    const c2 = [p2[0] - (p3[0] - p1[0]) / 6, p2[1] - (p3[1] - p1[1]) / 6];
    d += ` C${c1[0].toFixed(1)},${c1[1].toFixed(1)} ${c2[0].toFixed(1)},${c2[1].toFixed(1)} ${p2[0]},${p2[1]}`;
  }
  return closed ? d + 'Z' : d;
}

const coast: Pt[] = [
  [-10, 50], [40, 56], [80, 64], [120, 62], [150, 60], [176, 62], [186, 72], [180, 92], [172, 112],
  [168, 134], [164, 160], [170, 188], [182, 216], [160, 232], [122, 246], [90, 260], [60, 280], [30, 300], [-10, 324],
];
const coastPath = smooth(coast);
const landPath = `${coastPath} L-10,430 L-10,-10 Z`;

const islands: { name: string; pts: Pt[]; c: Pt; rings: number[] }[] = [
  { name: 'Culebra', c: [510, 140], rings: [1.18, 1.4],
    pts: [[462, 130], [474, 116], [494, 110], [514, 116], [532, 112], [552, 120], [558, 136], [548, 154], [530, 166], [512, 162], [498, 170], [480, 166], [466, 154]] },
  { name: 'Vieques', c: [375, 328], rings: [1.1, 1.22],
    pts: [[222, 322], [244, 304], [284, 298], [330, 300], [380, 296], [440, 300], [500, 304], [526, 316], [524, 334], [500, 346], [450, 350], [400, 354], [340, 360], [286, 358], [246, 348]] },
  { name: 'Culebrita', c: [574, 128], rings: [1.8], pts: [[566, 124], [576, 119], [583, 127], [575, 136], [566, 132]] },
  { name: 'Icacos', c: [206, 62], rings: [2.2], pts: [[196, 63], [206, 58], [217, 61], [209, 66], [198, 67]] },
  { name: 'Lobos', c: [224, 76], rings: [], pts: [[220, 74], [226, 72], [229, 77], [222, 80]] },
  { name: 'Palomino', c: [237, 100], rings: [2], pts: [[230, 97], [238, 94], [245, 100], [238, 106], [230, 104]] },
  { name: 'Palominito', c: [245, 113], rings: [], pts: [[242, 112], [246, 110], [249, 114], [244, 116]] },
  { name: 'St. Thomas', c: [868, 114], rings: [1.12, 1.26],
    pts: [[770, 118], [790, 100], [820, 92], [850, 96], [880, 90], [915, 94], [945, 100], [968, 112], [960, 124], [930, 128], [900, 134], [870, 136], [840, 132], [810, 134], [785, 130]] },
  { name: 'Cayo Norte', c: [560, 104], rings: [], pts: [[552, 104], [560, 100], [568, 103], [561, 107]] },
];

// The route, and where each stop sits on it (same order as `stops`).
const route =
  'M170,114 C176,98 190,80 202,70 C214,78 224,90 228,104 C250,170 300,250 330,292 C380,250 450,200 505,176 C620,172 760,160 868,140';
const stopPts: Pt[] = [[170, 114], [202, 70], [228, 104], [330, 292], [505, 176], [868, 140]];
const nm5 = (5 * 1000) / 60;
---

<section class="voyage" id="voyage" data-voyage style={`--v-bg:${stops[0].bg};--v-ink:${stops[0].ink}`}>
  <div class="voyage__sticky">
    <div class="voyage__grid wrap">
      <div class="voyage__chart">
        <svg viewBox="0 20 1000 390" role="img" aria-labelledby="voyage-legend" preserveAspectRatio="xMidYMid meet">
          <title id="voyage-legend">{ui.legend}</title>

          <g class="chart__contours">
            {[12, 26].map((o) => <path d={coastPath} transform={`translate(${o} ${o * 0.8})`} />)}
            {
              islands.flatMap((isl) =>
                isl.rings.map((s) => (
                  <path
                    d={smooth(isl.pts, true)}
                    transform={`translate(${isl.c[0]} ${isl.c[1]}) scale(${s}) translate(${-isl.c[0]} ${-isl.c[1]})`}
                  />
                )),
              )
            }
          </g>

          <path class="chart__land chart__land--fill" d={landPath} />
          <path class="chart__coast" d={coastPath} />
          {islands.map((isl) => <path class="chart__land" d={smooth(isl.pts, true)} />)}

          <g class="chart__labels">
            <text x="54" y="190" class="chart__region">Puerto Rico</text>
            <text x="560" y="34" class="chart__water">{lang === 'en' ? 'Atlantic Ocean' : 'Océano Atlántico'}</text>
            <text x="640" y="392" class="chart__water">{lang === 'en' ? 'Caribbean Sea' : 'Mar Caribe'}</text>
            <text x="868" y="80" text-anchor="middle">St. Thomas</text>
            <text x="868" y="160" text-anchor="middle" class="chart__small">{lang === 'en' ? 'U.S. Virgin Islands' : 'Islas Vírgenes de EE. UU.'}</text>
            <text x="250" y="250" class="chart__water">{lang === 'en' ? 'Vieques Passage' : 'Pasaje de Vieques'}</text>
            <text x="375" y="332" class="chart__region chart__region--sm">Vieques</text>
            <text x="512" y="98">Culebra</text>
            <text x="222" y="50">Icacos</text>
            <text x="252" y="98">Palomino</text>
            <text x="158" y="118" text-anchor="end">Fajardo</text>
            <text x="158" y="164" text-anchor="end" class="chart__small">Puerto del Rey</text>
          </g>

          <g class="chart__compass" transform="translate(940 290)">
            <circle r="20" />
            <circle r="15" />
            <path d="M0,-26 L4,0 L0,26 L-4,0 Z" />
            <path d="M-26,0 L0,3 L26,0 L0,-3 Z" class="chart__compass-minor" />
            <text y="-32" text-anchor="middle">N</text>
          </g>

          <g class="chart__scale" transform="translate(28 392)">
            <path d={`M0,0 H${nm5} M0,-4 V4 M${nm5},-4 V4 M${nm5 / 5},-2 V2 M${(nm5 * 2) / 5},-2 V2 M${(nm5 * 3) / 5},-2 V2 M${(nm5 * 4) / 5},-2 V2`} />
            <text x={nm5 + 8} y="4">{ui.scale}</text>
          </g>

          <path class="chart__route-ghost" d={route} />
          <path class="chart__route" d={route} data-route />

          {
            stopPts.map(([x, y]) => (
              <circle class="chart__stop" cx={x} cy={y} r="3.2" data-stop-dot />
            ))
          }
          <circle class="chart__stop" cx="164" cy="160" r="2.4" />

          <g class="chart__boat" data-boat transform={`translate(${stopPts[0][0]} ${stopPts[0][1]})`}>
            <circle class="chart__boat-pulse" r="6" />
            <circle class="chart__boat-dot" r="5" />
          </g>
        </svg>
        <script type="application/json" data-stop-pts set:html={JSON.stringify(stopPts)} />
      </div>

      <div class="voyage__log">
        <header class="voyage__head">
          <h2>{ui.title}</h2>
          <p>{ui.intro}</p>
        </header>

        <ol class="voyage__rail numeric" aria-hidden="true">
          {stops.map((s, i) => <li class:list={{ 'is-active': i === 0 }} data-rail>{s.nm ? `${s.nm} ${ui.unit}` : ui.start}</li>)}
        </ol>

        <ol class="voyage__entries">
          {
            stops.map((s, i) => (
              <li class:list={['voyage__entry', { 'is-active': i === 0 }]} data-entry data-bg={s.bg} data-ink={s.ink}>
                <figure class="voyage__img">
                  <img src={s.image} alt="" loading="lazy" />
                </figure>
                <div>
                  <p class="voyage__when numeric">
                    <em>{s.place}</em>
                    <span>{s.nm ? `${s.nm} ${ui.unit}, ${s.travel[lang]}` : s.travel[lang]}</span>
                  </p>
                  <h3>{s.title[lang]}</h3>
                  <p class="voyage__body">{s.body[lang]}</p>
                  {s.trip && (
                    <a class="link voyage__link" href={href(lang, `/trips/${s.trip}/`)}>
                      {t(lang).trips.book}
                    </a>
                  )}
                </div>
              </li>
            ))
          }
        </ol>
      </div>
    </div>
  </div>
</section>

<style>
  .voyage {
    position: relative;
    height: 640vh;
    background: var(--v-bg);
    color: var(--v-ink);
    --soft: color-mix(in oklab, var(--v-ink) 62%, var(--v-bg));
    --faint: color-mix(in oklab, var(--v-ink) 22%, transparent);
  }
  .voyage__sticky {
    position: sticky;
    top: 0;
    height: 100svh;
    display: flex;
    align-items: center;
    overflow: hidden;
  }
  .voyage__grid {
    display: grid;
    grid-template-columns: minmax(0, 2.5fr) minmax(19rem, 1fr);
    gap: clamp(2rem, 4vw, 5rem);
    align-items: center;
    padding-top: 76px;
  }

  /* ---- Chart ---- */
  .voyage__chart svg {
    width: 100%;
    height: auto;
    max-height: calc(100svh - 140px);
    overflow: visible;
  }
  .chart__land {
    fill: color-mix(in oklab, var(--v-ink) 9%, transparent);
    stroke: color-mix(in oklab, var(--v-ink) 55%, transparent);
    stroke-width: 0.8;
  }
  .chart__land--fill {
    stroke: none;
  }
  .chart__coast {
    fill: none;
    stroke: color-mix(in oklab, var(--v-ink) 55%, transparent);
    stroke-width: 0.8;
  }
  .chart__contours path {
    fill: none;
    stroke: var(--faint);
    stroke-width: 0.6;
    stroke-dasharray: 2 3;
    vector-effect: non-scaling-stroke;
  }
  .chart__labels text,
  .chart__scale text,
  .chart__compass text {
    font-family: var(--serif);
    font-style: italic;
    font-size: 13px;
    fill: var(--v-ink);
  }
  .chart__labels .chart__small {
    font-size: 10px;
    fill: var(--soft);
  }
  .chart__labels .chart__region {
    font-size: 22px;
    letter-spacing: 0.04em;
    fill: color-mix(in oklab, var(--v-ink) 45%, transparent);
  }
  .chart__labels .chart__region--sm {
    font-size: 14px;
    text-anchor: middle;
  }
  .chart__labels .chart__water {
    font-size: 12px;
    letter-spacing: 0.3em;
    fill: var(--soft);
  }
  .chart__compass circle,
  .chart__scale path {
    fill: none;
    stroke: var(--soft);
    stroke-width: 0.7;
  }
  .chart__compass path {
    fill: var(--v-ink);
  }
  .chart__compass .chart__compass-minor {
    fill: var(--soft);
  }
  .chart__scale text {
    font-size: 9px;
    font-style: normal;
    font-family: var(--sans);
    fill: var(--soft);
  }
  .chart__route-ghost {
    fill: none;
    stroke: var(--faint);
    stroke-width: 1;
    stroke-dasharray: 1 4;
    stroke-linecap: round;
  }
  .chart__route {
    fill: none;
    stroke: var(--brass);
    stroke-width: 1.8;
    stroke-linecap: round;
  }
  .chart__stop {
    fill: var(--v-bg);
    stroke: var(--v-ink);
    stroke-width: 1;
    transition: fill 0.4s;
  }
  .chart__stop.is-reached {
    fill: var(--brass);
    stroke: var(--brass);
  }
  .chart__boat-dot {
    fill: var(--brass);
    stroke: var(--v-bg);
    stroke-width: 2;
  }
  .chart__boat-pulse {
    fill: none;
    stroke: var(--brass);
    animation: pulse 2.2s var(--ease) infinite;
    transform-box: fill-box;
    transform-origin: center;
  }
  @keyframes pulse {
    from {
      transform: scale(1);
      opacity: 0.9;
    }
    to {
      transform: scale(3.2);
      opacity: 0;
    }
  }

  /* ---- Log ---- */
  .voyage__log {
    display: grid;
    grid-template-columns: auto 1fr;
    grid-template-rows: auto 1fr;
    column-gap: 2rem;
    row-gap: 2.5rem;
  }
  .voyage__head {
    grid-column: 1 / -1;
  }
  .voyage__head h2 {
    font-size: clamp(2rem, 1.2rem + 2.2vw, 3.4rem);
    margin-bottom: 1rem;
  }
  .voyage__head p {
    color: var(--soft);
    max-width: 38ch;
  }
  .voyage__rail {
    list-style: none;
    margin: 0;
    padding: 0 0 0 1rem;
    border-left: 1px solid var(--faint);
    display: flex;
    flex-direction: column;
    gap: 0.9rem;
    font-family: var(--serif);
    font-size: 0.95rem;
    white-space: nowrap;
  }
  .voyage__rail li {
    position: relative;
    color: var(--soft);
    opacity: 0.6;
    transition:
      opacity 0.4s,
      color 0.4s;
  }
  .voyage__rail li::before {
    content: '';
    position: absolute;
    left: calc(-1rem - 1px);
    top: 0;
    bottom: 0;
    width: 1px;
    background: var(--brass);
    transform: scaleY(0);
    transition: transform 0.5s var(--ease);
  }
  .voyage__rail li.is-active {
    opacity: 1;
    color: var(--v-ink);
  }
  .voyage__rail li.is-active::before {
    transform: scaleY(1);
  }
  .voyage__entries {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
  }
  .voyage__entry {
    grid-area: 1 / 1;
    visibility: hidden;
  }
  .voyage__entry.is-active {
    visibility: visible;
  }
  .voyage__img {
    margin: 0 0 1.3rem;
    aspect-ratio: 16 / 10;
    overflow: hidden;
    border-radius: 2px;
    background: var(--faint);
  }
  .voyage__img img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .voyage__when {
    display: flex;
    gap: 1rem;
    font-size: var(--t-small);
    color: var(--soft);
    margin-bottom: 0.5rem;
  }
  .voyage__when em {
    font-family: var(--serif);
    color: var(--v-ink);
  }
  .voyage__link {
    display: inline-block;
    margin-top: 1rem;
    font-size: 0.95rem;
  }
  .voyage__entry h3 {
    font-size: clamp(1.5rem, 1.1rem + 1vw, 2.1rem);
    margin-bottom: 0.6rem;
  }
  .voyage__body {
    color: var(--soft);
    max-width: 40ch;
  }

  @media (max-width: 900px) {
    .voyage__grid {
      grid-template-columns: 1fr;
      gap: 1rem;
      align-content: start;
      padding-top: 84px;
      height: 100svh;
    }
    .voyage__chart svg {
      max-height: 36svh;
      overflow: hidden;
    }
    .voyage__head p,
    .voyage__rail {
      display: none;
    }
    .voyage__head h2 {
      font-size: 1.7rem;
      margin: 0;
    }
    .voyage__log {
      grid-template-columns: 1fr;
      row-gap: 1rem;
    }
    .voyage__img {
      aspect-ratio: 16 / 8;
      margin-bottom: 0.9rem;
    }
    .voyage__entry h3 {
      font-size: 1.4rem;
    }
    .voyage__body {
      font-size: 0.95rem;
    }
  }

  /* Without motion: a plain, readable list of the day. */
  @media (prefers-reduced-motion: reduce) {
    .voyage {
      height: auto;
    }
    .voyage__sticky {
      position: static;
      height: auto;
      padding-block: 6rem;
    }
    .voyage__entries {
      gap: 3rem;
    }
    .voyage__entry {
      grid-area: auto;
      visibility: visible;
    }
    .voyage__rail {
      display: none;
    }
    .chart__route-ghost {
      stroke: var(--brass);
    }
  }
</style>

<script>
  import { gsap, reducedMotion } from '../scripts/motion';

  const section = document.querySelector<HTMLElement>('[data-voyage]')!;
  const route = section.querySelector<SVGPathElement>('[data-route]')!;
  const boat = section.querySelector<SVGGElement>('[data-boat]')!;
  const dots = section.querySelectorAll<SVGCircleElement>('[data-stop-dot]');
  const entries = [...section.querySelectorAll<HTMLElement>('[data-entry]')];
  const rail = section.querySelectorAll<HTMLElement>('[data-rail]');
  const pts: [number, number][] = JSON.parse(section.querySelector('[data-stop-pts]')!.textContent!);

  const len = route.getTotalLength();

  // Where each stop falls along the route, searching forward so the return leg
  // doesn't match the departure point.
  const at: number[] = [];
  let from = 0;
  pts.forEach(([x, y], i) => {
    if (i === pts.length - 1) return at.push(1);
    let best = from;
    let bestD = Infinity;
    for (let l = from; l <= len; l += len / 600) {
      const p = route.getPointAtLength(l);
      const d = (p.x - x) ** 2 + (p.y - y) ** 2;
      if (d < bestD) [bestD, best] = [d, l];
      else if (d > bestD + 400) break;
    }
    at.push(best / len);
    from = best + 1;
  });

  if (reducedMotion) {
    route.style.display = 'none';
  } else {
    route.style.strokeDasharray = `${len}`;
    route.style.strokeDashoffset = `${len}`;

    const state = { r: 0 };
    let active = 0;

    const show = (next: number) => {
      if (next === active) return;
      const prev = entries[active];
      const cur = entries[next];
      const dir = next > active ? 1 : -1;
      active = next;
      rail.forEach((li, i) => li.classList.toggle('is-active', i === next));
      dots.forEach((d, i) => d.classList.toggle('is-reached', i <= next));

      gsap.killTweensOf([prev, cur, prev.querySelector('img'), cur.querySelector('img')]);
      gsap.to(prev, {
        opacity: 0,
        y: -24 * dir,
        duration: 0.45,
        ease: 'power2.in',
        onComplete: () => prev.classList.remove('is-active'),
      });
      cur.classList.add('is-active');
      gsap.fromTo(cur, { opacity: 0, y: 32 * dir }, { opacity: 1, y: 0, duration: 0.9, delay: 0.25, ease: 'expo.out' });
      gsap.fromTo(
        cur.querySelector('.voyage__img'),
        { clipPath: dir > 0 ? 'inset(100% 0 0 0)' : 'inset(0 0 100% 0)' },
        { clipPath: 'inset(0% 0 0 0)', duration: 1.1, delay: 0.2, ease: 'expo.out' },
      );
      gsap.fromTo(cur.querySelector('img'), { scale: 1.25 }, { scale: 1, duration: 1.6, delay: 0.2, ease: 'expo.out' });
    };

    // On narrow screens the whole chart is too small to read, so the view zooms in
    // and follows the boat like a camera.
    const svg = section.querySelector('svg')!;
    const fullView = svg.getAttribute('viewBox')!;
    const narrow = window.matchMedia('(max-width: 900px)');
    const follow = (x: number, y: number) => {
      if (!narrow.matches) return svg.setAttribute('viewBox', fullView);
      const w = 470;
      const h = 330;
      const vx = gsap.utils.clamp(0, 1000 - w, x - w / 2);
      const vy = gsap.utils.clamp(10, 410 - h, y - h / 2);
      svg.setAttribute('viewBox', `${vx.toFixed(1)} ${vy.toFixed(1)} ${w} ${h}`);
    };
    narrow.addEventListener('change', () => render());

    const render = () => {
      const l = state.r * len;
      const p = route.getPointAtLength(l);
      follow(p.x, p.y);
      route.style.strokeDashoffset = `${len - l}`;
      boat.setAttribute('transform', `translate(${p.x} ${p.y})`);
      let next = 0;
      at.forEach((a, i) => state.r >= a - 0.004 && (next = i));
      show(next);
    };

    render();

    // Travel between stops, pause at each. The water changes color on the way.
    const tl = gsap.timeline({
      defaults: { ease: 'none' },
      scrollTrigger: { trigger: section, start: 'top top', end: 'bottom bottom', scrub: 1 },
    });
    tl.to({}, { duration: 0.5 });
    entries.forEach((entry, i) => {
      if (i === 0) return;
      // Text color flips quickly mid-leg so it never fades into a background of the same tone.
      tl.to(state, { r: at[i], duration: 1, ease: 'sine.inOut', onUpdate: render }, '>')
        .to(section, { '--v-bg': entry.dataset.bg, duration: 1 }, '<')
        .to(section, { '--v-ink': entry.dataset.ink, duration: 0.12 }, '<0.45')
        .to({}, { duration: 0.55 }, '>0.43');
    });
  }
</script>
