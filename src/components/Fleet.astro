---
import { boats } from '../data/boats';
import { trips } from '../data/trips';
import { href, t, type Lang } from '../i18n';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const ui = t(lang).fleet;
const tripsFor = (slug: string) => trips.filter((x) => x.boats.includes(slug));
---

<section class="fleet" id="fleet" data-fleet>
  <div class="wrap">
    <header class="fleet__head">
      <h2>{ui.title}</h2>
      <p class="lead">{ui.intro}</p>
    </header>

    <ul class="fleet__grid">
      {
        boats.map((boat) => (
          <li class="boat-card" data-boat-card>
            <button type="button" class="boat-card__btn" data-open={boat.slug} aria-haspopup="dialog">
              <span class="boat-card__media">
                <img src={boat.image} alt="" loading="lazy" />
              </span>
              <span class="boat-card__name">{boat.name}</span>
              <span class="boat-card__kind">{boat.kind[lang]}</span>
              <span class="boat-card__meta numeric">
                {t(lang).trips.guests(boat.guests)}, {ui.captain.toLowerCase()} {boat.captain}
              </span>
              <span class="boat-card__more">
                <i aria-hidden="true"></i>
                {ui.details}
              </span>
            </button>
          </li>
        ))
      }
    </ul>
  </div>

  {
    boats.map((boat) => {
      const photos = [boat.image, ...boat.gallery];
      return (
        <dialog class="boat-dialog" data-dialog={boat.slug} aria-labelledby={`boat-${boat.slug}`} data-lenis-prevent>
          <div class="bd" data-panel>
            <div class="bd__carousel" data-carousel>
              {photos.map((src, i) => (
                <figure class:list={['bd__slide', { 'is-active': i === 0 }]} data-slide aria-hidden={i !== 0}>
                  <img src={src} alt={i === 0 ? `${boat.name}, ${boat.kind[lang]}` : ''} loading="lazy" />
                </figure>
              ))}
              <div class="bd__controls">
                <button type="button" data-step="-1" aria-label={ui.prev}>
                  <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M15 5l-7 7 7 7" /></svg>
                </button>
                <p class="numeric" aria-live="polite">
                  <span class="visually-hidden" data-photo-label>{ui.photo(1, photos.length)}</span>
                  <span aria-hidden="true"><span data-photo-i>1</span> / {photos.length}</span>
                </p>
                <button type="button" data-step="1" aria-label={ui.next}>
                  <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 5l7 7-7 7" /></svg>
                </button>
              </div>
              <div class="bd__dots" aria-hidden="true">
                {photos.map((_, i) => <span class:list={{ 'is-active': i === 0 }} />)}
              </div>
            </div>

            <div class="bd__info" data-info>
              <button type="button" class="bd__close" data-close aria-label={ui.close}>
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18" /></svg>
              </button>
              <h3 class="bd__name" id={`boat-${boat.slug}`}>{boat.name}</h3>
              <p class="bd__kind">{boat.kind[lang]}</p>
              <p class="bd__about">{boat.about[lang]}</p>

              <dl class="bd__specs numeric">
                <div><dt>{ui.length}</dt><dd>{boat.lengthFt} ft</dd></div>
                <div><dt>{ui.guests}</dt><dd>{boat.guests}</dd></div>
                <div><dt>{ui.captain}</dt><dd>{boat.captain}</dd></div>
                <div><dt>{ui.best}</dt><dd>{boat.bestFor[lang]}</dd></div>
              </dl>

              <h4>{ui.onboard}</h4>
              <ul class="bd__list">{boat.amenities[lang].map((a) => <li>{a}</li>)}</ul>

              <h4>{ui.runs}</h4>
              <ul class="bd__trips">
                {tripsFor(boat.slug).map((trip) => (
                  <li>
                    <a class="link" href={`${href(lang, `/trips/${trip.slug}/`)}?boat=${boat.slug}`}>{trip.name[lang]}</a>
                  </li>
                ))}
              </ul>

              <button type="button" class="btn bd__cta" data-close data-goto="#trips">
                {ui.book(boat.name)}
              </button>
            </div>
          </div>
        </dialog>
      );
    })
  }
</section>

<style>
  .fleet {
    background: var(--atlantic);
    color: var(--salt);
    padding-block: clamp(6rem, 16vh, 11rem);
    --soft: color-mix(in oklab, var(--salt) 66%, var(--atlantic));
  }
  .fleet .lead {
    color: var(--soft);
  }
  .fleet__head {
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: end;
    gap: 2rem;
    margin-bottom: clamp(2.5rem, 6vh, 4.5rem);
  }
  .fleet__grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(1.25rem, 2.2vw, 2.25rem);
  }
  .boat-card__btn {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    width: 100%;
    padding: 0;
    border: 0;
    background: none;
    text-align: left;
    cursor: pointer;
  }
  .boat-card__media {
    display: block;
    width: 100%;
    aspect-ratio: 4 / 5;
    overflow: hidden;
    border-radius: 2px;
    margin-bottom: 1.25rem;
  }
  .boat-card__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 1.4s var(--ease);
  }
  .boat-card__btn:hover .boat-card__media img {
    transform: scale(1.05);
  }
  .boat-card__name {
    font-family: var(--serif);
    font-style: italic;
    font-size: clamp(2.4rem, 1.6rem + 2vw, 3.6rem);
    line-height: 1;
    margin-bottom: 0.4rem;
  }
  .boat-card__kind {
    font-size: 1.02rem;
    margin-bottom: 0.2rem;
  }
  .boat-card__meta {
    font-size: 0.9rem;
    color: var(--soft);
    margin-bottom: 1.1rem;
  }
  .boat-card__more {
    display: inline-flex;
    align-items: center;
    gap: 0.7rem;
    font-size: 0.95rem;
  }
  .boat-card__more i {
    position: relative;
    width: 34px;
    height: 34px;
    border: 1px solid rgb(242 245 243 / 0.4);
    border-radius: 50%;
    transition:
      background 0.4s var(--ease),
      border-color 0.4s var(--ease),
      transform 0.6s var(--ease);
  }
  .boat-card__more i::before,
  .boat-card__more i::after {
    content: '';
    position: absolute;
    left: 50%;
    top: 50%;
    width: 12px;
    height: 1px;
    background: currentColor;
    translate: -50% -50%;
  }
  .boat-card__more i::after {
    rotate: 90deg;
  }
  .boat-card__btn:hover .boat-card__more i {
    background: var(--brass);
    border-color: var(--brass);
    color: var(--atlantic);
    transform: rotate(90deg);
  }

  /* ---- Expanded boat ---- */
  .boat-dialog {
    width: min(1240px, calc(100vw - 2 * var(--gutter)));
    max-width: none;
    height: min(820px, calc(100svh - 2 * var(--gutter)));
    max-height: none;
    padding: 0;
    border: 0;
    border-radius: 4px;
    background: var(--salt);
    color: var(--atlantic);
    overflow: hidden;
  }
  .boat-dialog::backdrop {
    background: rgb(4 20 29 / 0.72);
    backdrop-filter: blur(6px);
  }
  .bd {
    display: grid;
    grid-template-columns: minmax(0, 1.35fr) minmax(0, 1fr);
    height: 100%;
  }
  .bd__carousel {
    position: relative;
    overflow: hidden;
    background: var(--atlantic);
    touch-action: pan-y;
  }
  .bd__slide {
    position: absolute;
    inset: 0;
    margin: 0;
    visibility: hidden;
  }
  .bd__slide.is-active {
    visibility: visible;
  }
  .bd__slide img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .bd__controls {
    position: absolute;
    left: 1.25rem;
    bottom: 1.25rem;
    display: flex;
    align-items: center;
    gap: 0.9rem;
    color: var(--salt);
    font-family: var(--serif);
  }
  .bd__controls button {
    width: 46px;
    height: 46px;
    border-radius: 50%;
    border: 1px solid rgb(242 245 243 / 0.55);
    background: rgb(4 20 29 / 0.25);
    backdrop-filter: blur(6px);
    color: var(--salt);
    cursor: pointer;
    display: grid;
    place-items: center;
    transition: background 0.3s;
  }
  .bd__controls button:hover {
    background: rgb(4 20 29 / 0.55);
  }
  .bd__controls svg {
    width: 18px;
    height: 18px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.5;
  }
  .bd__dots {
    position: absolute;
    right: 1.25rem;
    bottom: 1.9rem;
    display: flex;
    gap: 6px;
  }
  .bd__dots span {
    width: 18px;
    height: 2px;
    background: rgb(242 245 243 / 0.4);
    transition:
      background 0.4s,
      width 0.4s var(--ease);
  }
  .bd__dots span.is-active {
    width: 34px;
    background: var(--salt);
  }
  .bd__info {
    position: relative;
    overflow-y: auto;
    overscroll-behavior: contain;
    padding: clamp(1.5rem, 3vw, 3rem);
  }
  .bd__close {
    position: absolute;
    top: 1rem;
    right: 1rem;
    width: 44px;
    height: 44px;
    border: 1px solid var(--line);
    border-radius: 50%;
    background: var(--salt);
    cursor: pointer;
    display: grid;
    place-items: center;
    transition: transform 0.5s var(--ease);
  }
  .bd__close:hover {
    transform: rotate(90deg);
  }
  .bd__close svg {
    width: 18px;
    height: 18px;
    stroke: currentColor;
    stroke-width: 1.5;
  }
  .bd__name {
    font-size: clamp(3rem, 2rem + 3vw, 5rem);
    font-style: italic;
    line-height: 0.95;
    margin: 0.5rem 0 0.5rem;
  }
  .bd__kind {
    font-size: 1.05rem;
    margin-bottom: 1.1rem;
  }
  .bd__about {
    color: var(--ink-soft);
    margin-bottom: 1.6rem;
    max-width: 44ch;
  }
  .bd__specs {
    margin: 0 0 1.8rem;
    border-top: 1px solid var(--line);
  }
  .bd__specs div {
    display: grid;
    grid-template-columns: 6.5rem 1fr;
    gap: 1rem;
    padding: 0.6rem 0;
    border-bottom: 1px solid var(--line);
    font-size: 0.95rem;
  }
  .bd__specs dt {
    color: var(--ink-soft);
  }
  .bd__specs dd {
    margin: 0;
  }
  .bd__info h4 {
    font-family: var(--serif);
    font-weight: 400;
    font-size: 1.3rem;
    margin: 0 0 0.6rem;
  }
  .bd__list {
    list-style: none;
    margin: 0 0 1.6rem;
    padding: 0;
    columns: 2;
    column-gap: 1.5rem;
    font-size: 0.95rem;
  }
  .bd__list li {
    break-inside: avoid;
    padding: 0.2rem 0 0.2rem 1.1rem;
    position: relative;
  }
  .bd__list li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.85em;
    width: 0.55rem;
    height: 1px;
    background: var(--brass);
  }
  .bd__trips {
    list-style: none;
    margin: 0 0 2rem;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 1.25rem;
    font-size: 0.95rem;
  }

  @media (max-width: 900px) {
    .fleet__head {
      grid-template-columns: 1fr;
    }
    .fleet__grid {
      grid-template-columns: 1fr;
      gap: 3rem;
    }
    .boat-card__media {
      aspect-ratio: 4 / 3;
    }
    .boat-dialog {
      width: 100vw;
      height: 100svh;
      border-radius: 0;
    }
    .bd {
      grid-template-columns: 1fr;
      grid-template-rows: 42svh 1fr;
    }
    .bd__info {
      position: static;
    }
    .bd__close {
      position: fixed;
      top: 0.9rem;
      right: 0.9rem;
      z-index: 2;
    }
    .bd__list {
      columns: 1;
    }
  }
</style>

<script>
  import { gsap, lenis, reducedMotion } from '../scripts/motion';

  const section = document.querySelector<HTMLElement>('[data-fleet]')!;

  section.querySelectorAll<HTMLDialogElement>('[data-dialog]').forEach((dialog) => {
    const opener = section.querySelector<HTMLButtonElement>(`[data-open="${dialog.dataset.dialog}"]`)!;
    const panel = dialog.querySelector<HTMLElement>('[data-panel]')!;
    const slides = [...dialog.querySelectorAll<HTMLElement>('[data-slide]')];
    const dots = dialog.querySelectorAll('.bd__dots span');
    const counter = dialog.querySelector<HTMLElement>('[data-photo-i]')!;
    const label = dialog.querySelector<HTMLElement>('[data-photo-label]')!;
    const info = dialog.querySelector<HTMLElement>('[data-info]')!;
    let index = 0;
    let closing = false;

    const go = (dir: number) => {
      const prev = slides[index];
      index = (index + dir + slides.length) % slides.length;
      const next = slides[index];
      counter.textContent = String(index + 1);
      label.textContent = label.textContent!.replace(/\d+/, String(index + 1));
      dots.forEach((d, i) => d.classList.toggle('is-active', i === index));
      slides.forEach((s) => s.setAttribute('aria-hidden', String(s !== next)));
      next.classList.add('is-active');
      if (reducedMotion) {
        prev.classList.remove('is-active');
        return;
      }
      gsap.killTweensOf([prev, next, next.querySelector('img')]);
      gsap.set(next, { zIndex: 2 });
      gsap.set(prev, { zIndex: 1 });
      gsap.fromTo(
        next,
        { clipPath: dir > 0 ? 'inset(0 0 0 100%)' : 'inset(0 100% 0 0)' },
        { clipPath: 'inset(0 0% 0 0%)', duration: 0.9, ease: 'expo.inOut', onComplete: () => prev !== next && prev.classList.remove('is-active') },
      );
      gsap.fromTo(next.querySelector('img'), { scale: 1.2, xPercent: 8 * dir }, { scale: 1, xPercent: 0, duration: 1.2, ease: 'expo.out' });
    };

    dialog.querySelectorAll<HTMLButtonElement>('[data-step]').forEach((b) => b.addEventListener('click', () => go(Number(b.dataset.step))));

    // Swipe on touch screens
    const carousel = dialog.querySelector<HTMLElement>('[data-carousel]')!;
    let startX: number | null = null;
    carousel.addEventListener('pointerdown', (e) => (startX = e.clientX));
    carousel.addEventListener('pointerup', (e) => {
      if (startX === null) return;
      const dx = e.clientX - startX;
      if (Math.abs(dx) > 40) go(dx < 0 ? 1 : -1);
      startX = null;
    });

    const open = () => {
      closing = false;
      lenis?.stop();
      dialog.showModal();
      info.scrollTop = 0;
      if (reducedMotion) return;
      gsap.fromTo(panel, { clipPath: 'inset(100% 0 0 0)' }, { clipPath: 'inset(0% 0 0 0)', duration: 1, ease: 'expo.out' });
      gsap.fromTo(slides[index].querySelector('img'), { scale: 1.3 }, { scale: 1, duration: 1.6, ease: 'expo.out' });
      gsap.fromTo(info.children, { opacity: 0, y: 30 }, { opacity: 1, y: 0, duration: 0.9, stagger: 0.04, delay: 0.25, ease: 'expo.out' });
    };

    const close = (goto?: string) => {
      if (closing || !dialog.open) return;
      closing = true;
      const done = () => {
        dialog.close();
        lenis?.start();
        opener.focus({ preventScroll: true });
        const target = goto && document.querySelector<HTMLElement>(goto);
        if (target) lenis ? lenis.scrollTo(target, { duration: 1.4 }) : target.scrollIntoView();
      };
      if (reducedMotion) return done();
      gsap.to(panel, { clipPath: 'inset(0 0 100% 0)', duration: 0.6, ease: 'expo.in', onComplete: done });
    };

    opener.addEventListener('click', open);
    dialog.querySelectorAll<HTMLElement>('[data-close]').forEach((el) => el.addEventListener('click', () => close(el.dataset.goto)));
    // Click on the backdrop closes; Esc closes with the same animation.
    dialog.addEventListener('click', (e) => e.target === dialog && close());
    dialog.addEventListener('cancel', (e) => {
      e.preventDefault();
      close();
    });
    dialog.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowRight') go(1);
      if (e.key === 'ArrowLeft') go(-1);
    });
  });

  if (!reducedMotion) {
    // Cards rise in together; each photo opens from the bottom edge.
    const cards = section.querySelectorAll<HTMLElement>('[data-boat-card]');
    gsap
      .timeline({ scrollTrigger: { trigger: section.querySelector('.fleet__grid'), start: 'top 80%' } })
      .from(cards, { y: 60, opacity: 0, duration: 1.2, stagger: 0.12, ease: 'expo.out' })
      .from(
        section.querySelectorAll('.boat-card__media'),
        { clipPath: 'inset(100% 0 0 0)', duration: 1.3, stagger: 0.12, ease: 'expo.out' },
        0,
      );
  }
</script>
