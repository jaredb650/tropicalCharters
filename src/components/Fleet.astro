---
import { boats } from '../data/boats';
import { t, type Lang } from '../i18n';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const ui = t(lang).fleet;
---

<section class="fleet" id="fleet" data-fleet>
  <div class="fleet__sticky">
    <div class="fleet__track" data-track>
      <header class="fleet__intro">
        <h2>{ui.title}</h2>
        <p class="lead">{ui.intro}</p>
        <p class="fleet__count numeric" aria-hidden="true">
          <span data-count>1</span> / {boats.length}
        </p>
      </header>

      {
        boats.map((boat) => (
          <article class="boat" data-boat-panel>
            <div class="boat__media">
              <img src={boat.image} alt={`${boat.name}, ${boat.kind[lang]}`} loading="lazy" data-parallax />
            </div>
            <div class="boat__text">
              <h3 class="boat__name">{boat.name}</h3>
              <p class="boat__kind">{boat.kind[lang]}</p>
              <p class="boat__about">{boat.about[lang]}</p>
              <dl class="boat__specs numeric">
                <div>
                  <dt>{ui.length}</dt>
                  <dd>{boat.lengthFt} ft</dd>
                </div>
                <div>
                  <dt>{ui.guests}</dt>
                  <dd>{boat.guests}</dd>
                </div>
                <div>
                  <dt>{ui.captain}</dt>
                  <dd>{boat.captain}</dd>
                </div>
                <div>
                  <dt>{ui.best}</dt>
                  <dd>{boat.bestFor[lang]}</dd>
                </div>
              </dl>
            </div>
          </article>
        ))
      }
    </div>
    <div class="fleet__progress" aria-hidden="true"><span data-progress></span></div>
  </div>
</section>

<style>
  .fleet {
    position: relative;
    background: var(--atlantic);
    color: var(--salt);
    --soft: color-mix(in oklab, var(--salt) 66%, var(--atlantic));
  }
  .fleet .lead {
    color: var(--soft);
  }
  .fleet__sticky {
    position: sticky;
    top: 0;
    height: 100svh;
    overflow: hidden;
    display: flex;
    align-items: center;
  }
  .fleet__track {
    display: flex;
    align-items: center;
    /* Much wider between boats than within one, so each photo reads with its own specs */
    gap: clamp(6rem, 16vw, 18rem);
    padding-inline: var(--gutter) 12vw;
    padding-top: 60px;
    will-change: transform;
  }
  .fleet__intro {
    flex: 0 0 min(30rem, 34vw);
  }
  .fleet__intro h2 {
    margin-bottom: 1.5rem;
  }
  .fleet__count {
    margin-top: 3rem;
    font-family: var(--serif);
    font-style: italic;
    color: var(--soft);
  }
  .boat {
    flex: 0 0 auto;
    display: grid;
    grid-template-columns: min(52vw, 860px) minmax(16rem, 22rem);
    gap: clamp(1.25rem, 2vw, 2rem);
    align-items: end;
  }
  .boat__media {
    height: min(68svh, 640px);
    overflow: hidden;
    border-radius: 2px;
  }
  .boat__media img {
    width: 120%;
    max-width: none;
    height: 100%;
    object-fit: cover;
  }
  .boat__name {
    font-size: clamp(3.5rem, 2rem + 4vw, 7rem);
    font-style: italic;
    line-height: 0.9;
    margin-bottom: 0.6rem;
  }
  .boat__kind {
    font-size: 1.05rem;
    margin-bottom: 1.4rem;
  }
  .boat__about {
    color: var(--soft);
    margin-bottom: 1.8rem;
  }
  .boat__specs {
    margin: 0;
    display: grid;
    border-top: 1px solid rgb(242 245 243 / 0.2);
  }
  .boat__specs div {
    display: grid;
    grid-template-columns: 6.5rem 1fr;
    gap: 1rem;
    padding: 0.7rem 0;
    border-bottom: 1px solid rgb(242 245 243 / 0.2);
    font-size: 0.95rem;
  }
  .boat__specs dt {
    color: var(--soft);
  }
  .boat__specs dd {
    margin: 0;
  }
  .fleet__progress {
    position: absolute;
    left: var(--gutter);
    right: var(--gutter);
    bottom: clamp(1.5rem, 4vh, 2.5rem);
    height: 1px;
    background: rgb(242 245 243 / 0.18);
  }
  .fleet__progress span {
    position: absolute;
    inset: 0;
    background: var(--brass-light);
    transform: scaleX(0);
    transform-origin: left;
  }

  /* Stacked on small screens and without motion */
  @media (max-width: 860px), (prefers-reduced-motion: reduce) {
    .fleet__sticky {
      position: static;
      height: auto;
      display: block;
      padding-block: 6rem;
    }
    .fleet__track {
      flex-direction: column;
      align-items: stretch;
      padding-inline: var(--gutter);
      padding-top: 0;
      gap: 4.5rem;
    }
    .fleet__intro,
    .boat {
      flex: none;
    }
    .fleet__count,
    .fleet__progress {
      display: none;
    }
    .boat {
      grid-template-columns: 1fr;
    }
    .boat__media {
      height: auto;
      aspect-ratio: 4 / 3;
    }
    .boat__media img {
      width: 100%;
    }
  }
</style>

<script>
  import { gsap, ScrollTrigger, reducedMotion } from '../scripts/motion';

  const section = document.querySelector<HTMLElement>('[data-fleet]')!;
  const track = section.querySelector<HTMLElement>('[data-track]')!;
  const progress = section.querySelector<HTMLElement>('[data-progress]')!;
  const count = section.querySelector<HTMLElement>('[data-count]')!;
  const panels = section.querySelectorAll<HTMLElement>('[data-boat-panel]');

  const mm = gsap.matchMedia();
  mm.add('(min-width: 861px) and (prefers-reduced-motion: no-preference)', () => {
    // The section is as tall as the track is wide, so vertical scroll maps 1:1 to sideways travel.
    const distance = () => track.scrollWidth - window.innerWidth;
    const setHeight = () => (section.style.height = `${distance() + window.innerHeight}px`);
    setHeight();
    ScrollTrigger.addEventListener('refreshInit', setHeight);

    const slide = gsap.to(track, {
      x: () => -distance(),
      ease: 'none',
      scrollTrigger: {
        trigger: section,
        start: 'top top',
        end: 'bottom bottom',
        scrub: 0.8,
        invalidateOnRefresh: true,
        onUpdate: (self) => gsap.set(progress, { scaleX: self.progress }),
      },
    });

    // Each photo drifts inside its frame as it crosses the screen, and the counter follows along.
    panels.forEach((panel, i) => {
      gsap.fromTo(
        panel.querySelector('[data-parallax]'),
        { xPercent: -16 },
        {
          xPercent: 0,
          ease: 'none',
          scrollTrigger: { trigger: panel, containerAnimation: slide, start: 'left right', end: 'right left', scrub: true },
        },
      );
      gsap.from(panel.querySelectorAll('.boat__name, .boat__kind, .boat__about, .boat__specs'), {
        y: 50,
        opacity: 0,
        stagger: 0.08,
        duration: 1,
        ease: 'expo.out',
        scrollTrigger: { trigger: panel, containerAnimation: slide, start: 'left 70%', toggleActions: 'play none none reverse' },
      });
      ScrollTrigger.create({
        trigger: panel,
        containerAnimation: slide,
        start: 'left center',
        end: 'right center',
        onToggle: (self) => self.isActive && (count.textContent = String(i + 1)),
      });
    });

    return () => {
      ScrollTrigger.removeEventListener('refreshInit', setHeight);
      section.style.height = '';
    };
  });
</script>
