---
import { site } from '../data/site';
import type { Lang } from '../i18n';
import { t } from '../i18n';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const word = (s: string) => [...s].map((ch) => ch);
---

<div class="loader" data-loader="intro" aria-hidden="true">
  <div class="loader__half loader__half--top" data-loader-top></div>
  <div class="loader__half loader__half--bottom" data-loader-bottom></div>

  <div class="loader__center">
    <p class="loader__coords numeric" data-loader-coords>
      <span data-target="18">00</span>°<span data-target="20">00</span>′ N
      <span class="loader__gap"></span>
      <span data-target="65">00</span>°<span data-target="38">00</span>′ W
    </p>

    <p class="loader__mark">
      <span class="loader__word">
        {word('Tropical').map((ch) => <span class="loader__mask"><span class="loader__ch">{ch}</span></span>)}
      </span>
      <span class="loader__word loader__word--italic">
        {word('Charters').map((ch) => <span class="loader__mask"><span class="loader__ch">{ch}</span></span>)}
      </span>
    </p>

    <div class="loader__horizon">
      <span class="loader__line" data-loader-line></span>
      <span class="loader__pct numeric" data-loader-pct>0</span>
    </div>
  </div>
  <p class="visually-hidden" role="status">{t(lang).loader}</p>
</div>

<noscript><style>.loader{display:none}</style></noscript>

<style>
  .loader {
    position: fixed;
    inset: 0;
    z-index: 100;
    display: grid;
    place-items: center;
    pointer-events: none;
  }
  .loader__half {
    position: absolute;
    left: 0;
    right: 0;
    height: 50.5%;
    background: var(--salt);
  }
  .loader__half--top {
    top: 0;
  }
  .loader__half--bottom {
    bottom: 0;
  }
  .loader__center {
    position: relative;
    width: min(88vw, 760px);
    text-align: center;
    color: var(--atlantic);
  }
  .loader__coords {
    font-family: var(--serif);
    font-size: 0.95rem;
    letter-spacing: 0.08em;
    color: var(--ink-soft);
    margin-bottom: 1.4rem;
  }
  .loader__gap {
    display: inline-block;
    width: 2.2em;
  }
  .loader__mark {
    font-family: var(--serif);
    font-size: clamp(3rem, 1rem + 8vw, 7.5rem);
    line-height: 0.95;
    letter-spacing: -0.02em;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    column-gap: 0.25em;
  }
  .loader__word {
    display: inline-flex;
  }
  .loader__word--italic {
    font-style: italic;
  }
  .loader__mask {
    display: inline-block;
    overflow: hidden;
    /* Wide masks with matching negative margins so italic overhangs aren't clipped */
    padding: 0.06em 0.12em 0.14em;
    margin-inline: -0.12em;
  }
  .loader__ch {
    display: inline-block;
    transform: translateY(110%);
  }
  .loader__horizon {
    position: relative;
    margin-top: 2.2rem;
    height: 1px;
  }
  .loader__line {
    position: absolute;
    inset: 0;
    background: var(--atlantic);
    transform: scaleX(0);
    transform-origin: left center;
  }
  .loader__pct {
    position: absolute;
    right: 0;
    top: 0.8rem;
    font-family: var(--serif);
    font-size: 0.95rem;
    color: var(--ink-soft);
  }
</style>

<script>
  import { gsap, markReady, reducedMotion } from '../scripts/motion';
  import { endLoading, startLoading, trackAssets } from '../scripts/loading';

  const root = document.querySelector<HTMLElement>('[data-loader="intro"]');
  if (root) {
    const chars = root.querySelectorAll<HTMLElement>('.loader__ch');
    const line = root.querySelector<HTMLElement>('[data-loader-line]')!;
    const pct = root.querySelector<HTMLElement>('[data-loader-pct]')!;
    const coords = root.querySelectorAll<HTMLElement>('[data-target]');
    const top = root.querySelector('[data-loader-top]')!;
    const bottom = root.querySelector('[data-loader-bottom]')!;
    const center = root.querySelector('.loader__center')!;

    // Returning visitors in the same session get the short version.
    let seen = false;
    try {
      seen = sessionStorage.getItem('tc-loaded') === '1';
      sessionStorage.setItem('tc-loaded', '1');
    } catch {}

    startLoading();
    const finish = () => endLoading(root);

    if (reducedMotion) {
      gsap.to(root, { autoAlpha: 0, duration: 0.4, delay: 0.2, onStart: markReady, onComplete: finish });
    } else {
      const assets = trackAssets();
      const shown = { v: 0 };
      const minTime = seen ? 0.5 : 2.4;

      const intro = gsap.timeline();
      intro.to(chars, { y: 0, duration: 1.1, ease: 'expo.out', stagger: 0.045 }, 0.15);

      // The counter chases the real progress but never finishes before minTime.
      const progress = gsap.to(shown, {
        v: 1,
        duration: minTime,
        ease: 'power2.inOut',
        onUpdate() {
          // Hold at 92% until the real assets are in.
          const v = Math.min(shown.v, assets.progress() === 1 ? 1 : 0.92);
          gsap.set(line, { scaleX: v });
          pct.textContent = String(Math.round(v * 100));
          coords.forEach((el) => {
            const target = Number(el.dataset.target);
            el.textContent = String(Math.round(target * v)).padStart(2, '0');
          });
        },
      });

      Promise.all([assets.ready, progress.then(), intro.then()]).then(() => {
        gsap.set(line, { scaleX: 1 });
        pct.textContent = '100';
        coords.forEach((el) => (el.textContent = el.dataset.target!.padStart(2, '0')));

        gsap
          .timeline({ onComplete: finish })
          .to(chars, { y: '-110%', duration: 0.7, ease: 'expo.in', stagger: 0.02 })
          .to([pct, root.querySelector('.loader__coords')], { autoAlpha: 0, duration: 0.4 }, '<')
          .to(line, { scaleX: 3, duration: 0.6, ease: 'power3.in' }, '-=0.35')
          .add(markReady, '-=0.05')
          .to(center, { autoAlpha: 0, duration: 0.2 }, '<')
          .to(top, { yPercent: -100, duration: 1.3, ease: 'expo.inOut' }, '<')
          .to(bottom, { yPercent: 100, duration: 1.3, ease: 'expo.inOut' }, '<');
      });
    }
  }
</script>
